generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum LayoutStatus {
  draft
  published
}

/// Satu baris = satu versi layout sebuah tab. `data` divalidasi Zod (TabLayout).
model LayoutVersion {
  id          Int          @id @default(autoincrement())
  tab         String
  version     Int
  status      LayoutStatus @default(draft)
  data        Json
  createdBy   String?
  createdAt   DateTime     @default(now())
  publishedAt DateTime?

  @@unique([tab, version])
  @@index([tab, status])
}

/// Profil layout TV bersama; satu profil menyimpan layout untuk setiap tab.
model TvLayoutProfile {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  layouts   Json
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Ambang status bersama untuk satu indikator; nilai bands mengikuti BandDef.
model IndicatorThreshold {
  key       String   @id @db.VarChar(191)
  bands     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Riwayat login yang berhasil, tanpa menyimpan kredensial atau token.
model LoginLog {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(254)
  name      String?  @db.VarChar(191)
  role      String   @db.VarChar(10)
  provider  String   @db.VarChar(50)
  userAgent String?  @db.VarChar(512)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String   @db.VarChar(50)
  actor     String?  @db.VarChar(254)
  target    String?  @db.VarChar(191)
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
}

model TravoAlertState {
  unit       Int
  key        String   @db.VarChar(191)
  critical   Boolean
  awaitingNormal Boolean
  observedAt DateTime

  @@id([unit, key])
}
