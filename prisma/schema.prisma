generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum LayoutStatus {
  draft
  published
}

/// Satu baris = satu versi layout sebuah tab. `data` divalidasi Zod (TabLayout).
model LayoutVersion {
  id          Int          @id @default(autoincrement())
  tab         String
  version     Int
  status      LayoutStatus @default(draft)
  data        Json
  createdBy   String?
  createdAt   DateTime     @default(now())
  publishedAt DateTime?

  @@unique([tab, version])
  @@index([tab, status])
}

/// Profil layout TV bersama; satu profil menyimpan layout untuk setiap tab.
model TvLayoutProfile {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  layouts   Json
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Ambang status bersama untuk satu indikator; nilai bands mengikuti BandDef.
model IndicatorThreshold {
  key       String   @id @db.VarChar(191)
  bands     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
